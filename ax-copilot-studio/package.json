{
  "name": "ax-copilot-studio",
  "displayName": "Ax Copilot Studio",
  "description": "Define a DSPy-style signature, pick a module (Predict / ChainOfThought / ReAct), and run it against your GitHub Copilot subscription using the Ax framework.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "axCopilot.openStudio",
        "title": "Ax Copilot: Open Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "axCopilotStudio",
          "title": "Ax Copilot Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "axCopilotStudio": [
        {
          "type": "webview",
          "id": "axCopilot.studioView",
          "name": "Studio"
        }
      ]
    },
    "configuration": {
      "title": "Ax Copilot Studio",
      "properties": {
        "axCopilot.enterpriseDomain": {
          "type": "string",
          "default": "",
          "description": "GitHub Enterprise (GHE.com) domain for Copilot auth, e.g. mycompany.ghe.com. Leave empty for github.com."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:webview": "tsc --noEmit -p src/webview/ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ax-llm/ax": "^13.0.24"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
